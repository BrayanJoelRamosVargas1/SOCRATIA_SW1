# Local PostgreSQL
POSTGRES_DB=socratia
POSTGRES_USER=socratia
POSTGRES_PASSWORD=socratia_dev_password
DATABASE_URL=postgresql+psycopg://socratia:socratia_dev_password@db:5432/socratia

# Generate a production value with: openssl rand -hex 32
JWT_SECRET=change-this-development-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_IDENTIFIER=3
PASSWORD_RESET_MAX_REQUESTS_PER_IP=10
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOCAL_STORAGE_PATH=./uploads
MAX_DOCUMENT_SIZE_MB=20

# Transactional email (Brevo SMTP). Never commit the real SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM_NAME=Socratia
MAIL_FROM_EMAIL=

# Browser-facing API URL (embedded in the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Reserved for later sprints; do not commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
PINECONE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
