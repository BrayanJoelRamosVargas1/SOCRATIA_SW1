# Copy to .env.staging at the repository root. Never commit populated secrets.
# Generate secrets with infrastructure/scripts/init_staging_env.py.
PUBLIC_DOMAIN=staging.example.com
POSTGRES_PASSWORD=
JWT_SECRET=

# Configure the providers you intend to exercise. Empty keys do not make APIs free.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_QUESTION_MODEL=gemini-3.6-flash
VISION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GROQ_QUESTION_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Testing cost controls: bounded contexts, one generation attempt, no paid TTS.
QUESTION_CONTEXT_MAX_CHARS=12000
QUESTION_GENERATION_MAX_ATTEMPTS=1
GEMINI_QUESTION_MAX_OUTPUT_TOKENS=8192
GROQ_QUESTION_MAX_OUTPUT_TOKENS=4096
GROQ_QUESTION_MAX_CONTEXT_CHARS=10000
EVALUATION_CONTEXT_MAX_CHARS=12000
EVALUATION_MAX_RETRIES=1
VOICE_TTS_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false
MAX_DOCUMENT_SIZE_MB=10
DOCUMENT_MAX_CHUNKS=100
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20

# Optional transactional email for password reset.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Socratia
