# Local PostgreSQL
POSTGRES_DB=socratia
POSTGRES_USER=socratia
POSTGRES_PASSWORD=socratia_dev_password
DATABASE_URL=postgresql+psycopg://socratia:socratia_dev_password@db:5432/socratia

# Generate a production value with: openssl rand -hex 32
JWT_SECRET=change-this-development-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_IDENTIFIER=3
PASSWORD_RESET_MAX_REQUESTS_PER_IP=10
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOCAL_STORAGE_PATH=./uploads
MAX_DOCUMENT_SIZE_MB=20

# Transactional email (Brevo SMTP). Never commit the real SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM_NAME=Socratia
MAIL_FROM_EMAIL=

# Document processing (CU09). Never commit real provider keys.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT_SECONDS=60
DOCUMENT_CHUNK_SIZE_CHARS=3000
DOCUMENT_CHUNK_OVERLAP_CHARS=400
DOCUMENT_MAX_CHUNKS=500

VECTOR_PRIMARY_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=socratia-documents
PINECONE_NAMESPACE_PREFIX=socratia
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_TIMEOUT_SECONDS=60

# RAG question bank (CU10): Gemini primary, Groq fallback.
QUESTION_RETRIEVAL_TOP_K=4
QUESTION_CONTEXT_MAX_CHARS=45000
QUESTION_GENERATION_TIMEOUT_SECONDS=90
QUESTION_GENERATION_MAX_ATTEMPTS=2
GEMINI_QUESTION_MAX_OUTPUT_TOKENS=8192
GROQ_QUESTION_MAX_OUTPUT_TOKENS=4096
QUESTION_CIRCUIT_BREAKER_THRESHOLD=3
QUESTION_CIRCUIT_BREAKER_RECOVERY_SECONDS=60
GEMINI_QUESTION_MODEL=gemini-2.5-flash
GROQ_QUESTION_MODEL=openai/gpt-oss-20b
GROQ_QUESTION_MAX_CONTEXT_CHARS=10000
GROQ_API_KEY=

# Reserved for P3 live simulation.
GROQ_LIVE_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Browser-facing API URL (embedded in the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Reserved for later sprints; do not commit real values.
AWS_REGION=
S3_BUCKET=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
